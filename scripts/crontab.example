# Example crontab for real-time model verification.
#
# Install with:   crontab scripts/crontab.example
# Or merge lines into your existing crontab with:   crontab -e
#
# Each line verifies ONE model+variable against the analysis. Add more lines
# for more combinations. Cron times are interpreted in the system timezone, but
# the wrapper forces TZ=UTC and the job picks its analysis time from "now - lag"
# (default 2h), so exact minute-of-hour only affects when the snapshot is taken.
#
# Stagger start minutes so jobs don't all hit the data servers at once.
# Always redirect stdout+stderr to a per-job log (the app also writes its own
# rotating comparison.log).

SHELL=/bin/bash
WRAPPER=/home/jneedham/DAG_ModelComparison/scripts/run_comparison.sh
LOGDIR=/home/jneedham/dag/logs

# min hour dom mon dow   command
  0   *    *   *   *     $WRAPPER --model hrrr   --var TMP  --verif rtma >> $LOGDIR/cron.hrrr.tmp.log  2>&1
  5   *    *   *   *     $WRAPPER --model hrrr   --var WIND --verif rtma >> $LOGDIR/cron.hrrr.wind.log 2>&1
 10   *    *   *   *     $WRAPPER --model nam12k --var TMP  --verif rtma >> $LOGDIR/cron.nam.tmp.log   2>&1

# Example: a daily retrospective GIF (all forecast leads vs one analysis time):
# 30  6    *   *   *     $WRAPPER --model hrrr --var TMP --verif rtma --mode gif >> $LOGDIR/cron.hrrr.gif.log 2>&1
